{
    "name": "Chitin",
    "author": "OriginalSwayze",
    "description": "A biomechanical interface grown rather than built: bone white and charcoal with dull metal and a sickly ochre, asymmetric organic panels that slowly breathe, a rib cage down the game list, navigation as a spine of four vertebrae along the bottom, seed-pod buttons, and a heartbeat monitor in the title bar whose pulse quickens while a game runs.",
    "version": "1.0.0",
    "tags": [
        "Organic",
        "Surreal",
        "Sci-fi",
        "Bone",
        "Dark"
    ],
    "header_image": "https://raw.githubusercontent.com/OriginalSwayze/Chitin/main/media/library.gif",
    "splash_image": "https://raw.githubusercontent.com/OriginalSwayze/Chitin/main/media/gamepage.png",
    "github": {
        "owner": "OriginalSwayze",
        "repo_name": "Chitin"
    },
    "Steam-WebKit": "webkit.css",
    "Conditions": {
        "Tissue": {
            "description": "Bone, Ivory & rust, Bronze or Ash.",
            "tab": "Appearance",
            "default": "Bone",
            "values": {
                "Bone": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/presets/bone.css"
                    }
                },
                "Ivory & rust": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/presets/ivory.css"
                    }
                },
                "Bronze": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/presets/bronze.css"
                    }
                },
                "Ash": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/presets/ash.css"
                    }
                }
            }
        },
        "Breathing": {
            "description": "Panels slowly breathe, or stay still.",
            "tab": "Appearance",
            "default": "Breathing",
            "values": {
                "Breathing": {},
                "Still": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/still.css"
                    }
                }
            }
        },
        "Game list density": {
            "description": "Row size in the game list.",
            "tab": "Layout",
            "default": "Comfortable",
            "values": {
                "Comfortable": {},
                "Compact": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/list-compact.css"
                    }
                }
            }
        },
        "What's New shelf": {
            "description": "The What's New carousel on the library home.",
            "tab": "Layout",
            "default": "Show",
            "values": {
                "Show": {},
                "Hide": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/hide-whats-new.css"
                    }
                }
            }
        },
        "Readout": {
            "description": "The heartbeat monitor: ECG trace, BPM and time.",
            "tab": "Layout",
            "default": "On",
            "values": {
                "On": {},
                "Off": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/hud-off.css"
                    }
                }
            }
        },
        "Startup screen": {
            "description": "The gestation screen when Steam opens.",
            "tab": "Motion",
            "default": "On",
            "values": {
                "On": {},
                "Off": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/boot-off.css"
                    }
                }
            }
        },
        "Motion": {
            "description": "Full: everything. Calm: hovers only, the backdrop stands still. Still: no theme motion.",
            "tab": "Motion",
            "default": "Full",
            "values": {
                "Full": {},
                "Calm": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/motion-calm.css"
                    }
                },
                "Still": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/motion-still.css"
                    }
                }
            }
        },
        "Cover hover": {
            "description": "Library covers under the cursor: Tilt, Lift or Off.",
            "tab": "Motion",
            "default": "Tilt",
            "values": {
                "Tilt": {},
                "Lift": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/covers-lift.css"
                    }
                },
                "Off": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/covers-off.css"
                    }
                }
            }
        },
        "Privacy": {
            "description": "Blur your account name and wallet until hovered.",
            "tab": "Extras",
            "default": "Off",
            "values": {
                "Off": {},
                "Blur": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/privacy.css"
                    }
                }
            }
        },
        "Contrast": {
            "description": "High: solid panels and brighter secondary text.",
            "tab": "Accessibility",
            "default": "Normal",
            "values": {
                "Normal": {},
                "High": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/contrast-high.css"
                    }
                }
            }
        },
        "Focus rings": {
            "description": "Strong: a thick, high-visibility outline on whatever has keyboard or controller focus.",
            "tab": "Accessibility",
            "default": "Standard",
            "values": {
                "Standard": {},
                "Strong": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/focus-strong.css"
                    }
                }
            }
        },
        "Text size": {
            "description": "Large: bigger game list and body text.",
            "tab": "Accessibility",
            "default": "Normal",
            "values": {
                "Normal": {},
                "Large": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/text-large.css"
                    }
                }
            }
        }
    },
    "Patches": [
        {
            "MatchRegexString": "^Steam$",
            "TargetCss": "main.css",
            "TargetJs": "js/main.js"
        },
        {
            "MatchRegexString": ".ModalDialogPopup",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": ".FullModalOverlay",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": ".friendsui-container",
            "TargetCss": "friends.css"
        },
        {
            "MatchRegexString": ".ContextMenuPopup",
            "TargetCss": "popup.css"
        },
        {
            "MatchRegexString": ".DesktopToastContainer",
            "TargetCss": "toast.css"
        },
        {
            "MatchRegexString": "^Sign in to Steam$",
            "TargetCss": "login.css"
        }
    ]
}
